# --- Runtime (stdlib only; no runtime dependencies) ---
# Python >= 3.10

# --- Dev (tests / lint / typecheck) ---
# pip install -e ".[dev]"
# pytest          # or: python -m unittest discover -s tests -v
# ruff check src eval demo tests
# mypy src

# --- Service ports / modes ---
PORT=8080
GATEWAY_MODE=mock            # mock | live (live requires provider creds; never needed for tests/demo/eval)
LOG_LEVEL=INFO

# --- Provider credentials (all optional; only used in live mode) ---
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# LOCAL_QWEN_ENDPOINT=http://localhost:11434
# LOCAL_BONSAI_ENDPOINT=http://localhost:11435
# LOCAL_GLIMMER_ENDPOINT=http://localhost:11436
# LOCAL_MUSE_ENDPOINT=http://localhost:11437

# --- Router tuning overrides (optional; JSON) ---
# GATEWAY_WEIGHTS_JSON={"task_affinity":0.20,"quality":0.20,"latency":0.15,"cost":0.10,"privacy":0.10,"context":0.08,"tools":0.07,"health":0.05,"history":0.05}
# GATEWAY_MAX_ATTEMPTS_PER_PROVIDER=2
# GATEWAY_DEFAULT_TIMEOUT_MS=8000
# GATEWAY_MAX_TOTAL_MS=30000
# GATEWAY_MAX_CONCURRENCY=16
